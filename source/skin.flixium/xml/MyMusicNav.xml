<?xml version="1.0" encoding="utf-8"?>
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<menucontrol>9000</menucontrol>
	<views>50,52,55,58,59,60,500,599</views>
	<controls>
		<control type="group">
			<description>Normal media browser outside source management</description>
			<visible>![String.StartsWith(Container.FolderPath,sources://) | [Window.IsActive(pictures) + String.IsEmpty(Container.FolderPath)]]</visible>
			<include>DefaultBackground</include>
			<include>GlassLegacyMusicPlane1</include>
			<control type="label" id="56000">
				<left>-3000</left>
				<top>-3000</top>
				<width>1</width>
				<height>1</height>
				<label>$VAR[MusicBlurFeedVar]</label>
				<visible>false</visible>
			</control>
			<control type="image" id="56010">
				<include>FullScreenDimensions</include>
				<aspectratio>scale</aspectratio>
				<fadetime>450</fadetime>
				<texture colordiffuse="$VAR[GlassBackdrop21VarTint]">$VAR[GlassBackdrop21Var]</texture>
				<visible>[$EXP[flixium_glass] + !Control.IsVisible(58) + !Control.IsVisible(59) + !Control.IsVisible(60)] | [Control.IsVisible(55) + [Container.Content(albums) | Container.Content(artists) | Container.Content(songs)] + System.AddonIsEnabled(script.flixium.helper) + !String.IsEmpty(Window(home).Property(flixium.helper.flix_blurred)) + !Skin.HasSetting(flix_disable_background_blur)]</visible>
			</control>
			<control type="image" id="56011">
				<include>FullScreenDimensions</include>
				<aspectratio>scale</aspectratio>
				<texture background="true" diffuse="special://skin/extras/flix-fanart-mask.png">$VAR[MusicBackgroundSourceVar]</texture>
				<visible>!Control.IsVisible(52) + !Control.IsVisible(55) + [!System.AddonIsEnabled(script.flixium.helper) | Skin.HasSetting(flix_disable_background_blur)]</visible>
			</control>
			<control type="group">
				<animation effect="fade" start="100" end="0" time="200" tween="sine" condition="$EXP[infodialog_active]">Conditional</animation>
				<include>View_50_List</include>
				<include>View_52_IconWall</include>
				
				<include>View_55_WideList</include>
				
				<include>View_58_FlixAlbums</include>
				<include>View_59_FlixArtists</include>
				<include>View_60_Tracks</include>
				<include>View_500_Wall</include>
				<include>CommonScrollbars</include>
				<control type="group">
					<include>OpenClose_Left</include>
					<visible>Control.IsVisible(55)</visible>
					<include>Visible_Left</include>
					<include>ListThumbInfoPanel</include>
				</control>
				<control type="group">
					<visible>false</visible>
					<include content="TopBar">
						<param name="breadcrumbs_label" value="$LOCALIZE[2]" />
					</include>
				</control>
				<control type="group">
					<visible>false</visible>
					<include content="BottomBar">
						<param name="info_visible" value="true" />
					</include>
				</control>
				<control type="group">
					<depth>DepthBars</depth>
					<bottom>0</bottom>
					<height>70</height>
					<visible>false</visible>
					<animation effect="fade" start="0" end="100" time="300" delay="300">WindowOpen</animation>
					<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
					<include condition="!Skin.HasSetting(hide_mediaflags) + ![Window.IsVisible(songinformation) | Window.IsVisible(musicinformation)]">MediaFlags</include>
				</control>
				<include>MediaMenuMouseOverlay</include>
				<control type="group">
					<include>MediaMenuCommon</include>
					<control type="grouplist" id="9000">
						<top>50</top>
						<include>MediaMenuListCommon</include>
						<control type="label" id="203">
							<description>Actions</description>
							<include>MediaMenuLabelCommon</include>
							<label>$LOCALIZE[31020]</label>
						</control>
						<control type="togglebutton" id="619">
							<include>MediaMenuItemsCommon</include>
							<label>$LOCALIZE[653]</label>
							<onclick>UpdateLibrary(music)</onclick>
							<visible>!Container.Content(addons)+ String.IsEmpty(Container.PluginName)</visible>
							<altlabel>$LOCALIZE[13353]</altlabel>
							<usealttexture>library.isscanningmusic</usealttexture>
						</control>
						<control type="radiobutton" id="16">
							<label>$LOCALIZE[589]</label>
							<include>MediaMenuItemsCommon</include>
						</control>
						<control type="button" id="612">
							<include>MediaMenuItemsCommon</include>
							<label>$LOCALIZE[31056]</label>
							<onclick>ActivateWindow(musicplaylist)</onclick>
							<visible>Integer.IsGreater(Playlist.Length(music),0)</visible>
						</control>
						<control type="button" id="621">
							<include>MediaMenuItemsCommon</include>
							<label>$LOCALIZE[21452]</label>
							<onclick>ActivateWindow(addonbrowser,addons://more/audio/,return)</onclick>
							<visible>Container.Content(addons)</visible>
						</control>
						<control type="button" id="624">
							<include>MediaMenuItemsCommon</include>
							<label>$LOCALIZE[10140]</label>
							<onclick>Addon.OpenSettings($INFO[Container.PluginName])</onclick>
							<visible>!String.IsEmpty(Container.PluginName)</visible>
						</control>
						<control type="button" id="622">
							<include>MediaMenuItemsCommon</include>
							<label>$LOCALIZE[31117]</label>
							<onclick condition="System.AddonIsEnabled(plugin.library.node.editor)">ActivateWindow(programs,plugin://plugin.library.node.editor/?ltype=music,return)</onclick>
							<onclick condition="System.HasAddon(plugin.library.node.editor) + !System.AddonIsEnabled(plugin.library.node.editor)">EnableAddon(plugin.library.node.editor)</onclick>
							<onclick condition="!System.HasAddon(plugin.library.node.editor)">InstallAddon(plugin.library.node.editor)</onclick>
							<visible>String.IsEmpty(Container.FolderPath) + String.IsEmpty(Container.PluginName)</visible>
						</control>
						<include>MediaMenuNowPlaying</include>
					</control>
				</control>
			</control>
		</control>
		<include content="FlixiumMediaSourcesPage">
			<param name="heading" value="$LOCALIZE[14243]" />
			<param name="fallback" value="DefaultMusicSources.png" />
		</include>
	</controls>
	<onload condition="[String.StartsWith(Container.FolderPath,sources://) | [Window.IsActive(pictures) + String.IsEmpty(Container.FolderPath)]]">Container.SetViewMode(599)</onload>
	<onload condition="![String.StartsWith(Container.FolderPath,sources://) | [Window.IsActive(pictures) + String.IsEmpty(Container.FolderPath)]] + String.IsEqual(Container.Viewmode,$LOCALIZE[20094])">Container.SetViewMode(50)</onload>
</window>
