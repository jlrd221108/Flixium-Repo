<?xml version="1.0" encoding="UTF-8"?>
<window>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion)) + !Skin.HasSetting(Flixium.Setup.Completed)">Skin.SetBool(Flixium.Setup.Pending)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion)) + !Skin.HasSetting(Flixium.Setup.Started) + !Skin.HasSetting(Flixium.Setup.Seen) + !Skin.HasSetting(Flixium.Setup.Completed)">Skin.SetBool(Flixium.Glass.Enabled)</onload>
	<onload condition="Skin.HasSetting(FlixiumRatingsEnabled) + !String.IsEqual(Window(home).Property(flixium.mdblist.service.running),true)">RunScript(special://skin/resources/lib/mdblist_service.py)</onload>
	<onload condition="!Skin.HasSetting(Flixium.SubtitleDefaultsApplied)">RunScript(special://skin/extras/flixium_subtitle_preset.py,initialise)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion))">RunScript(special://skin/extras/flixium_kodi_defaults.py)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion))">Skin.Reset(flix_disable_background_blur)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion))">Skin.SetBool(flix_hide_movie_progress)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion))">Skin.SetString(Flixium.BlurRadius,30)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion))">Skin.SetString(Flixium.BlurSaturation,1.5)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion))">Skin.SetString(Flixium.AgeRatingStyle,Legacy)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion))">Skin.SetString(Flixium.AgeRatingPosition,Right)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion))">Skin.SetBool(autoscroll)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion))">Skin.SetBool(HomeMenuNoMusicVideoButton)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion))">Skin.SetBool(HomeMenuNoTVButton)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion))">Skin.SetBool(HomeMenuNoRadioButton)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion))">Skin.SetBool(HomeMenuNoProgramsButton)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion))">Skin.SetBool(HomeMenuNoPicturesButton)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion))">Skin.SetBool(HomeMenuNoVideosButton)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion))">Skin.SetBool(HomeMenuNoGamesButton)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion))">Skin.SetBool(HomeMenuNoFavButton)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion))">Skin.SetBool(HomeMenuNoWeatherButton)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion))">Skin.Reset(FlixiumRatingsEnabled)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.DefaultsVersion))">Skin.SetString(Flixium.DefaultsVersion,1)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.RatingSlot1))">Skin.SetString(Flixium.RatingSlot1,mdblist)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.RatingSlot2))">Skin.SetString(Flixium.RatingSlot2,imdb)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.RatingSlot3))">Skin.SetString(Flixium.RatingSlot3,metacritic)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.RatingSlot4))">Skin.SetString(Flixium.RatingSlot4,rtc)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.RatingSlot5))">Skin.SetString(Flixium.RatingSlot5,rta)</onload>
	<onload condition="String.IsEmpty(Skin.String(Flixium.RatingSlot6))">Skin.SetString(Flixium.RatingSlot6,letterboxd)</onload>
	<!-- Never treat a deliberately disabled setting as an uninitialised default. -->
	<onload>ReplaceWindow($INFO[System.StartupWindow])</onload>
	<controls />
</window>
