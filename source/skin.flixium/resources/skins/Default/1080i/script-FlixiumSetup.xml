					<textoffsetx>0</textoffsetx>
					<onup condition="String.IsEqual(Window.Property(page),0) | String.IsEqual(Window.Property(page),4)">noop</onup>
					<onup condition="!String.IsEqual(Window.Property(page),0) + !String.IsEqual(Window.Property(page),4)">100</onup>
				</control>
			</control>
		</control>
		</control>
