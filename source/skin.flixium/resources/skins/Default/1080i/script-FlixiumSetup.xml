					<width>180</width>
					<label>$LOCALIZE[31365]</label>
					<visible>!String.IsEqual(Window.Property(page),0)</visible>
					<include>FlixiumSettingButton</include>
					<align>center</align>
					<textoffsetx>0</textoffsetx>
					<onup condition="String.IsEqual(Window.Property(page),0) | String.IsEqual(Window.Property(page),4)">noop</onup>
